{
    "@references":[
        {
            "name":"Jiang, Guillochon & Loeb 2016",
            "bibcode":"2016ApJ...830..125J"
        },
        {
            "name":"Guillochon & Ramirez-Ruiz 2015",
            "bibcode":"2015ApJ...809..166G"
        }
    ],
    "starmass":{
        "kind":"parameter",
        "value":1,
        "class":"kroupa"
    },
    "ebv":{
        "kind":"parameter",
        "value":0.0,
        "class":"parameter",
        "inputs":[
            "transient"
        ],
        "latex":"E({\\rm B} - {\\rm V})"
    },
    "rvhost":{
        "kind":"parameter",
        "value":3.1,
        "class":"parameter",
        "latex":"R_{\\rm V, host}"
    },
    "nhhost":{
        "kind":"parameter",
        "value":1e+21,
        "class":"parameter",
        "latex":"n_{\\rm H,host}",
        "derived_keys":"avhost"
    },
    "texplosion":{
        "kind":"parameter",
        "value":-12.0,
        "class":"parameter",
        "latex":"t_{\\rm exp}\\,{\\rm (days)}"
    },
    "b":{
        "kind":"parameter",
        "value":0.98,
        "class":"parameter",
        "latex":"b\\ (\\rm scaled\\ \\beta)",
        "derived_keys":"beta"
    },
    "frad":{
        "kind":"parameter",
        "value":0.03,
        "class":"parameter",
        "latex":"f_{\\rm rad}",
        "derived_keys":["shock_efficiency", "rp_over_rg"]
    },
    "efficiency":{
        "kind":"parameter",
        "value":0.1,
        "class":"parameter",
        "latex":"\\epsilon_{\\rm acc}"
    },
    "tviscnorm":{
        "kind":"parameter",
        "value":1.0,
        "class":"parameter",
        "fixed":true,
        "latex":"\\log_{10}(T_{\\rm visc}/t_{\\rm pk})\\ {\\rm at}\\ r_{\\rm p}/r_{\\rm g}=47"
    },
    "tviscslope":{
        "kind":"parameter",
        "value":2.1,
        "class":"parameter",
        "fixed":true,
        "latex":"{\\rm d}\\log T_{\\rm visc}/{\\rm d}\\log(r_{\\rm p}/r_{\\rm g})"
    },
    "tviscoffset":{
        "kind":"parameter",
        "value":0.0,
        "class":"parameter",
        "fixed":true,
        "latex":"\\Delta\\log_{10} T_{\\rm visc}"
    },
    "bhmass":{
        "kind":"parameter",
        "value":17800000.0,
        "class":"parameter",
        "latex":"M_{h} (M_{\\odot})"
    },
    "Rph0":{
        "kind":"parameter",
        "value":6.31,
        "class":"parameter",
        "latex":"R_{\\rm ph0}"
    },
    "lphoto":{
        "kind":"parameter",
        "value":1.5,
        "class":"parameter",
        "latex":"\\rm photosphere\\ \\rm  exponent\\ 'l' "
    },
    "Leddlim":{
        "kind":"parameter",
        "value":1,
        "class":"parameter",
        "fixed":true,
        "latex":"L_{\\rm edd,\\ limit}"
    },
    "rphotmaxwind":{
        "kind":"parameter",
        "value":1,
        "class":"parameter",
        "fixed":true,
        "latex":"\\rm R_{phot} \\ max, \\relativistic \\ wind \\ (boolean)"
    },
    "vphotmaxwind":{
        "kind":"parameter",
        "value":0.5,
        "class":"parameter",
        "fixed":true,
        "latex":"v_{\\rm phot \\ max} (\\rm fraction \\ of \\ c)"
    },
    "fallback":{
        "kind":"engine",
        "inputs":[
            "densetimes",
            "bhmass",
            "b",
            "frad",
            "efficiency",
            "texplosion",
            "starmass",
            "Leddlim"
        ],
        "replacements":{
            "luminosities":"acc_luminosities"
        }
    },
    "Tviscous":{
        "kind":"parameter",
        "value":1.0,
        "class":"darkyear",
        "inputs":[
            "fallback",
            "texplosion",
            "tviscnorm",
            "tviscslope",
            "tviscoffset"
        ],
        "latex":"T_{\\rm viscous}"
    },
    "viscous":{
        "kind":"transform",
        "inputs":[
            "fallback",
            "texplosion",
            "Tviscous"
        ],
        "replacements":{
            "luminosities":"acc_luminosities"
        }
    },
    "total_luminosity":{
        "kind":"utility",
        "operator":"+",
        "operands":[
            "shock_luminosities",
            "acc_luminosities"
        ],
        "inputs":[
            "fallback",
            "viscous"
        ],
        "result":"luminosities",
        "wants_dense":true,
        "class":"operator"
    },
    "leddcap":{
        "kind":"utility",
        "class":"leddcap",
        "inputs":[
            "total_luminosity",
            "fallback",
            "Leddlim"
        ],
        "wants_dense":true
    },
    "tde_photosphere":{
        "kind":"photosphere",
        "inputs":[
            "bhmass",
            "fallback",
            "lphoto",
            "Rph0",
            "leddcap"
        ]
    },
    "blackbody":{
        "kind":"sed",
        "inputs":[
            "texplosion",
            "redshift",
            "tde_photosphere"
        ],
        "requests":{
            "band_wave_ranges":"photometry"
        }
    },
    "losextinction":{
        "kind":"sed",
        "inputs":[
            "blackbody",
            "nhhost",
            "rvhost",
            "ebv"
        ],
        "requests":{
            "band_wave_ranges":"photometry"
        }
    },
    "photometry":{
        "kind":"observable",
        "inputs":[
            "losextinction",
            "lumdist"
        ],
        "supports":[
            "ultraviolet",
            "optical",
            "infrared",
            "bolometric"
        ]
    },
    "tde_constraints":{
        "kind":"constraint",
        "inputs":[
            "bhmass",
            "tde_photosphere",
            "rphotmaxwind",
            "vphotmaxwind"
        ]
    },
    "likelihood":{
        "kind":"objective",
        "supports":[
            "ultraviolet",
            "optical",
            "infrared"
        ],
        "inputs":[
            "diagonal",
            "tde_constraints"
        ]
    }
}
